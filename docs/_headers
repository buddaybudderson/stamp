# The Source of an issue is served as plain text: it is the byte-exact file whose SHA-256 is printed in the
# issue's PDF, meant to be downloaded and hashed, not rendered. As text, nothing on the way (our host's
# bot-detection script, which it adds to HTML pages) can change a byte of it. It is kept out of search results: the
# issue's page is the one to find, and it carries the same bytes.
/calibration/*/source
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
/calibration/*/source.html
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
/log/*/source
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
/log/*/source.html
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
